{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Save user-requested planner exports through a native save dialog. No shell or network API access.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "dialog:allow-save",
    "fs:allow-write-text-file",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://www.google.com/maps/*"
        }
      ]
    }
  ]
}
